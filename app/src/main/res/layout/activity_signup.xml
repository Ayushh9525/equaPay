<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Create Account"
        android:textColor="#1B1F3B"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Start splitting expenses with your friends"
        android:textColor="#5B6178"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editTextSignupName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="#1E88E5"
        android:hint="Full name"
        android:inputType="textPersonName"
        android:padding="14dp" />

    <EditText
        android:id="@+id/editTextSignupEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E88E5"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:padding="14dp" />

    <EditText
        android:id="@+id/editTextSignupUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E88E5"
        android:hint="Username"
        android:inputType="textNoSuggestions"
        android:padding="14dp" />

    <EditText
        android:id="@+id/editTextSignupPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E88E5"
        android:hint="Password"
        android:inputType="textPassword"
        android:padding="14dp" />

    <Button
        android:id="@+id/buttonSignup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#1E88E5"
        android:padding="14dp"
        android:text="Sign Up"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/textViewSignupStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#C62828"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textViewGoToLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Already have an account? Login"
        android:textColor="#1E88E5"
        android:textSize="15sp" />

</LinearLayout>
